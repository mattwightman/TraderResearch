# Copy to .env only if your own environment loader uses it. TraderResearch does
# not read this file automatically, and .env files must never be committed.
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=TraderResearch/0.1

IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1
IBKR_ENVIRONMENT=paper
IBKR_LIVE_TRADING_ENABLED=false

# Leave empty to use the OS-appropriate per-user application-data directory.
TRADERRESEARCH_DATA_DIR=
